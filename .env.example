# .env.example — コピーして .env にリネームし、実際のトークンを入力してください
# このファイル自体は .gitignore で管理し、絶対にコミットしないこと

# Vercel Personal Access Token
# 取得: https://vercel.com/account/tokens
VERCEL_TOKEN=your_vercel_token_here

# Vercel プロジェクト ID（Vercel ダッシュボード → Settings → General → Project ID）
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vercel チーム ID（個人アカウントは空でOK、チームアカウントは設定が必要）
VERCEL_TEAM_ID=

# GitHub Personal Access Token（repo スコープが必要）
# 取得: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here
